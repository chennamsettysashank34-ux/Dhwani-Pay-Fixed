{
  "name": "dhwanipay",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.26",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "lucide-react": "^1.56.0",
    "lucide-react-native": "^0.468.0",
    "payment-listener": "file:./modules/payment-listener",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "lucide-react-native": {
      "react": "$react"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react-dom"
      ]
    }
  }
}
